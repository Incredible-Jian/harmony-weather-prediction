<?xml version="1.0" encoding="utf-8"?>
<DependentLayout
    xmlns:ohos="http://schemas.huawei.com/res/ohos"
    ohos:height="match_parent"
    ohos:width="match_parent"
    ohos:background_element="$media:health"
    ohos:orientation="vertical">
    <Text
        ohos:id="$+id:health_title"
        ohos:text="生活指数"
        ohos:text_size="50fp"
        ohos:text_alignment="center"
        ohos:height="match_content"
        ohos:text_weight="700"
        ohos:text_color="#990000"
        ohos:width="match_parent"/>
    <Text
        ohos:id="$+id:health_v"
        ohos:text_size="30fp"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:align_parent_left="true"
        ohos:text="感觉:"
        ohos:top_margin="30vp"
        ohos:below="$id:health_title"
        ohos:text_weight="600"/>
    <Text
        ohos:id="$+id:health_v_feel"
        ohos:text_size="30fp"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:right_of="$id:health_v"
        ohos:text="开启制暖空调"
        ohos:top_margin="30vp"
        ohos:left_margin="10vp"
        ohos:text_color="#000000"
        ohos:below="$id:health_title"
        ohos:multiple_lines="true"
        ohos:max_text_lines="3"
        ohos:truncation_mode="ellipsis_at_end"
        ohos:text_weight="300"/>
    <Text
        ohos:id="$+id:health_des"
        ohos:text_size="30fp"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:align_parent_left="true"
        ohos:text="建议:"
        ohos:top_margin="30vp"
        ohos:below="$id:health_v"
        ohos:text_weight="600"/>
    <Text
        ohos:id="$+id:health_des_s"
        ohos:text_size="30fp"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:right_of="$id:health_des"
        ohos:text="您将感到有些冷，可以适当开启制暖空调调节室内温度，以免着凉感冒。"
        ohos:top_margin="30vp"
        ohos:left_margin="10vp"
        ohos:text_color="#000000"
        ohos:below="$id:health_v_feel"
        ohos:multiple_lines="true"
        ohos:max_text_lines="4"
        ohos:truncation_mode="ellipsis_at_end"
        ohos:text_weight="300"/>
    <Button
        ohos:id="$+id:health_re"
        ohos:width="match_parent"
        ohos:top_margin="30vp"
        ohos:height="match_content"
        ohos:below="$id:health_des_s"
        ohos:text_size="27fp"
        ohos:text="返回"
        ohos:background_element="$graphic:capsule_button_element"
        ohos:left_margin="15vp"
        ohos:bottom_margin="15vp"
        ohos:right_padding="15vp"
        ohos:left_padding="15vp"/>


</DependentLayout>