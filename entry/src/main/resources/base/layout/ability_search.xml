<?xml version="1.0" encoding="utf-8"?>
<DirectionalLayout
    xmlns:ohos="http://schemas.huawei.com/res/ohos"
    ohos:height="match_parent"
    ohos:width="match_parent"
    ohos:orientation="vertical"
    >

    <Text
        ohos:height="match_content"
        ohos:width="match_parent"
        ohos:background_element="#ff5151ec"
        ohos:padding="5vp"
        ohos:text="定位城市"
        ohos:text_alignment="center"
        ohos:text_color="#ffffff"
        ohos:text_size="30vp"
        />


    <DirectionalLayout
        ohos:height="match_content"
        ohos:width="match_parent"
        ohos:weight="3"
        ohos:orientation="vertical"
        >
        <DirectionalLayout
            ohos:height="match_content"
            ohos:width="match_parent"
            ohos:alignment="vertical_center"
            ohos:background_element="#dddddd"
            ohos:margin="20fp"
            ohos:orientation="horizontal"
            >
            <TextField
                ohos:id="$+id:search_tf1"
                ohos:height="match_content"
                ohos:width="0vp"
                ohos:weight="5"
                ohos:text_input_type="pattern_text"
                ohos:hint="请输入城市名称"
                ohos:hint_color="#aaaaaa"
                ohos:padding="15vp"
                ohos:text_color="#aaaaaa"
                ohos:text_size="20fp"
                />
            <Button
                ohos:id="$+id:b1"
                ohos:height="50vp"
                ohos:width="0vp"
                ohos:weight="1"
                ohos:background_element="$media:Find"
                ohos:left_margin="10vp"
                ohos:scale_mode="stretch"
                />
        </DirectionalLayout>
        <Text
            ohos:height="match_content"
            ohos:width="match_content"
            ohos:background_element="#FF58CAFF"
            ohos:padding="10vp"
            ohos:text="定位城市"
            ohos:text_alignment="center"
            ohos:left_margin="30vp"
            ohos:right_margin="30vp"
            ohos:text_color="#ffffff"
            ohos:text_size="20vp"
            ohos:text_weight="700"
            ohos:layout_alignment="center"
            />

        <Button
            ohos:id="$+id:b2"
            ohos:height="80vp"
            ohos:width="80vp"
            ohos:top_margin="10vp"
            ohos:text="北京"
            ohos:text_color="#ffffff"
            ohos:text_size="30vp"
            ohos:text_alignment="center"
            ohos:background_element="#FFAD76FF"
            ohos:layout_alignment="center"
            />
        <DirectionalLayout
            ohos:height="match_content"
            ohos:width="match_parent"
            ohos:alignment="vertical_center"
            ohos:background_element="$graphic:background_ability_main"
            ohos:left_margin="20fp"
            ohos:orientation="vertical"
            ohos:right_margin="20fp"
            >

            <Text
                ohos:height="match_content"
                ohos:width="match_parent"
                ohos:background_element="#FFFFDA58"
                ohos:padding="10vp"
                ohos:top_margin="60vp"
                ohos:text="热门城市"
                ohos:text_alignment="center"
                ohos:text_color="#ffffff"
                ohos:text_size="20vp"
                ohos:text_weight="700"
                />
        </DirectionalLayout>
    </DirectionalLayout>
    <DirectionalLayout
        ohos:height="match_content"
        ohos:width="match_parent"
        ohos:weight="3"
        ohos:margin="10vp"
        ohos:alignment="horizontal_center"
        ohos:orientation="vertical"
        >
        <DirectionalLayout
            ohos:height="match_content"
            ohos:orientation="horizontal"
            ohos:width="match_parent"
            >
            <DirectionalLayout
                ohos:height="match_content"
                ohos:width="match_content"
                ohos:alignment="center"
                ohos:weight="1"
                >
                <Button
                    ohos:id="$+id:c1"
                    ohos:height="240px"
                    ohos:width="240px"
                    ohos:background_element="#FFFFBD7A"
                    ohos:text_size="30vp"
                    ohos:text="北京"
                    ohos:text_alignment="center"
                    />
            </DirectionalLayout>
            <DirectionalLayout
                ohos:height="match_content"
                ohos:width="match_content"
                ohos:alignment="center"
                ohos:weight="1"
                >
                <Button
                    ohos:id="$+id:c2"
                    ohos:height="240px"
                    ohos:width="240px"
                    ohos:text_size="30vp"
                    ohos:background_element="#FFFFBD7A"
                    ohos:text="上海"
                    ohos:text_alignment="center"
                    />
            </DirectionalLayout>
            <DirectionalLayout
                ohos:height="match_content"
                ohos:width="match_content"
                ohos:alignment="center"
                ohos:weight="1"
                >
                <Button
                    ohos:id="$+id:c3"
                    ohos:height="240px"
                    ohos:width="240px"
                    ohos:text_size="30vp"
                    ohos:background_element="#FFFFBD7A"
                    ohos:text="深圳"
                    ohos:text_alignment="center"
                    />
            </DirectionalLayout>
        </DirectionalLayout>
        <DirectionalLayout
            ohos:height="match_content"
            ohos:orientation="horizontal"
            ohos:top_margin="10vp"
            ohos:width="match_parent"
            >
            <DirectionalLayout
                ohos:height="match_content"
                ohos:width="match_content"
                ohos:alignment="center"
                ohos:weight="1"
                >
                <Button
                    ohos:id="$+id:c4"
                    ohos:height="240px"
                    ohos:width="240px"
                    ohos:background_element="#FFFFBD7A"
                    ohos:text_size="30vp"
                    ohos:text="广州"
                    ohos:text_alignment="center"
                    />
            </DirectionalLayout>
            <DirectionalLayout
                ohos:height="match_content"
                ohos:width="match_content"
                ohos:alignment="center"
                ohos:weight="1">
                <Button
                    ohos:id="$+id:c5"
                    ohos:height="240px"
                    ohos:width="240px"
                    ohos:text_size="30vp"
                    ohos:background_element="#FFFFBD7A"
                    ohos:text="天津"
                    ohos:text_alignment="center"
                    />
            </DirectionalLayout>
            <DirectionalLayout
                ohos:height="match_content"
                ohos:width="match_content"
                ohos:alignment="center"
                ohos:weight="1"
                >
                <Button
                    ohos:id="$+id:c6"
                    ohos:height="240px"
                    ohos:width="240px"
                    ohos:text_size="30vp"
                    ohos:background_element="#FFFFBD7A"
                    ohos:text="杭州"
                    ohos:text_alignment="center"
                    />
            </DirectionalLayout>
        </DirectionalLayout>
        <DirectionalLayout
            ohos:height="match_content"
            ohos:orientation="horizontal"
            ohos:top_margin="10vp"
            ohos:width="match_parent"
            >
            <DirectionalLayout
                ohos:height="match_content"
                ohos:width="match_content"
                ohos:alignment="center"
                ohos:weight="1"
                >
                <Button
                    ohos:id="$+id:c7"
                    ohos:height="240px"
                    ohos:width="240px"
                    ohos:background_element="#FFFFBD7A"
                    ohos:text_size="30vp"
                    ohos:text="宁波"
                    ohos:text_alignment="center"
                    />
            </DirectionalLayout>
            <DirectionalLayout
                ohos:height="match_content"
                ohos:width="match_content"
                ohos:alignment="center"
                ohos:weight="1"
                >
                <Button
                    ohos:id="$+id:c8"
                    ohos:height="240px"
                    ohos:width="240px"
                    ohos:text_size="30vp"
                    ohos:background_element="#FFFFBD7A"
                    ohos:text="西安"
                    ohos:text_alignment="center"
                    />
            </DirectionalLayout>
            <DirectionalLayout
                ohos:height="match_content"
                ohos:width="match_content"
                ohos:alignment="center"
                ohos:weight="1"
                >
                <Button
                    ohos:id="$+id:c9"
                    ohos:height="240px"
                    ohos:width="240px"
                    ohos:text_size="30vp"
                    ohos:background_element="#FFFFBD7A"
                    ohos:text="成都"
                    ohos:text_alignment="center"
                    />
            </DirectionalLayout>
        </DirectionalLayout>
    </DirectionalLayout>
</DirectionalLayout>