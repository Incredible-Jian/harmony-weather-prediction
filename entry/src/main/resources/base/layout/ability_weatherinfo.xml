<?xml version="1.0" encoding="utf-8"?>
<DependentLayout
    xmlns:ohos="http://schemas.huawei.com/res/ohos"
    ohos:height="match_parent"
    ohos:width="match_parent"
    ohos:margin="20vp"
    ohos:background_element="$media:sunny"
    ohos:orientation="vertical">
    <Text
        ohos:id="$+id:weather_city_tv"
        ohos:text="兰州"
        ohos:text_size="46fp"
        ohos:text_weight="700"
        ohos:align_parent_top="true"
        ohos:horizontal_center="true"
        ohos:height="match_content"
        ohos:width="match_content"/>
    <Button
        ohos:id="$+id:weather_btn1"
        ohos:right_of="$id:weather_city_tv"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:align_bottom="$id:weather_city_tv"
        ohos:align_parent_right="true"
        ohos:background_element="$media:Find"/>
    <Text
        ohos:id="$+id:weather_tem_tv"
        ohos:below="$id:weather_city_tv"
        ohos:text_size="50vp"
        ohos:text="20℃"
        ohos:horizontal_center="true"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:top_margin="30vp"/>
    <Text
        ohos:id="$+id:weather_condition_tv"
        ohos:below="$id:weather_tem_tv"
        ohos:horizontal_center="true"
        ohos:top_margin="20vp"
        ohos:text="晴 15\/28℃ 空气优43"
        ohos:text_size="26fp"
        ohos:height="match_content"
        ohos:width="match_content"/>
    <Button
        ohos:id="$+id:weather_btn2"
        ohos:below="$id:weather_condition_tv"
        ohos:horizontal_center="true"
        ohos:text="查看所有天气种类"
        ohos:text_size="30fp"
        ohos:top_margin="20vp"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:text_color="#00E5EE"
        ohos:text_weight="500"/>
    <Text
        ohos:id="$+id:weather_day_tv1"
        ohos:below="$id:weather_btn2"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:top_margin="20vp"
        ohos:text="day1"
        ohos:text_color="#CD00CD"
        ohos:margin="12vp"
        ohos:text_size="20fp"
        ohos:align_parent_left="true"/>
    <Text
        ohos:id="$+id:weather_day_tv2"
        ohos:below="$id:weather_btn2"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:top_margin="20vp"
        ohos:text="day2"
        ohos:text_color="#CD00CD"
        ohos:margin="12vp"
        ohos:text_size="20fp"
        ohos:right_of="$id:weather_day_tv1"/>
    <Text
        ohos:id="$+id:weather_day_tv3"
        ohos:below="$id:weather_btn2"
        ohos:height="match_content"
        ohos:margin="12vp"
        ohos:width="match_content"
        ohos:top_margin="20vp"
        ohos:text_color="#CD00CD"
        ohos:text="day3"
        ohos:text_size="20fp"
        ohos:right_of="$id:weather_day_tv2"/>
    <Text
        ohos:id="$+id:weather_day_tv4"
        ohos:below="$id:weather_btn2"
        ohos:height="match_content"
        ohos:top_margin="20vp"
        ohos:text_color="#CD00CD"
        ohos:margin="12vp"
        ohos:width="match_content"
        ohos:text="day4"
        ohos:right_of="$id:weather_day_tv3"
        ohos:text_size="20fp"/>
    <Text
        ohos:id="$+id:weather_day_tv5"
        ohos:below="$id:weather_btn2"
        ohos:text_color="#CD00CD"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:top_margin="20vp"
        ohos:margin="12vp"
        ohos:text="day5"
        ohos:text_size="20fp"
        ohos:right_of="$id:weather_day_tv4"/>
    <Text
        ohos:id="$+id:weather_condition_tv2"
        ohos:below="$id:weather_day_tv1"
        ohos:top_margin="20vp"
        ohos:height="30vp"
        ohos:width="match_content"
        ohos:text_color="#FFB5C5"
        ohos:text="多云转晴"
        ohos:margin="8vp"
        ohos:text_size="15fp"
        ohos:text_alignment="center"
        ohos:align_left="$id:weather_day_tv2"/>
    <Text
        ohos:id="$+id:weather_condition_tv3"
        ohos:below="$id:weather_day_tv1"
        ohos:height="30vp"
        ohos:width="match_content"
        ohos:text="晴"
        ohos:text_alignment="center"
        ohos:top_margin="20vp"
        ohos:text_color="#FFB5C5"
        ohos:margin="8vp"
        ohos:text_size="15fp"
        ohos:align_left="$id:weather_day_tv3"/>
    <Text
        ohos:id="$+id:weather_condition_tv4"
        ohos:below="$id:weather_day_tv1"
        ohos:height="30vp"
        ohos:margin="8vp"
        ohos:top_margin="20vp"
        ohos:width="match_content"
        ohos:text="小雨"
        ohos:text_alignment="center"
        ohos:text_color="#FFB5C5"
        ohos:text_size="15fp"
        ohos:align_left="$id:weather_day_tv4"/>
    <Text
        ohos:id="$+id:weather_condition_tv5"
        ohos:below="$id:weather_day_tv1"
        ohos:height="30vp"
        ohos:top_margin="20vp"
        ohos:margin="8vp"
        ohos:width="match_content"
        ohos:text_color="#FFB5C5"
        ohos:text="多云转晴"
        ohos:text_alignment="center"
        ohos:text_size="15fp"
        ohos:align_left="$id:weather_day_tv5"/>
    <Text
        ohos:id="$+id:weather_condition_tv1"
        ohos:below="$id:weather_day_tv1"
        ohos:height="30vp"
        ohos:text_alignment="center"
        ohos:top_margin="20vp"
        ohos:margin="8vp"
        ohos:text_color="#FFB5C5"
        ohos:width="match_content"
        ohos:text="阵雨转晴"
        ohos:text_size="15fp"
        ohos:align_parent_left="true"/>
    <Text
        ohos:id="$+id:life_tv"
        ohos:text="生活状态"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:text_size="40fp"
        ohos:below="$id:weather_condition_tv5"
        ohos:center_in_parent="true"
        ohos:text_color="#00FF7F"
        ohos:top_margin="20vp"/>
    <Button
        ohos:id="$+id:life_count_btn1"
        ohos:text="过敏"
        ohos:padding="20vp"
        ohos:below="$id:life_tv"
        ohos:align_parent_left="true"
        ohos:text_size="30fp"
        ohos:text_color="#483D8B"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:text_weight="300"/>
    <Button
        ohos:id="$+id:life_count_btn2"
        ohos:text="穿衣"
        ohos:padding="20vp"
        ohos:below="$id:life_tv"
        ohos:align_bottom="$id:life_count_btn1"
        ohos:text_size="30fp"
        ohos:text_color="#6A5ACD"
        ohos:right_of="$id:life_count_btn1"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:text_weight="300"/>
    <Button
        ohos:id="$+id:life_count_btn3"
        ohos:text="舒适度"
        ohos:below="$id:life_tv"
        ohos:align_bottom="$id:life_count_btn1"
        ohos:text_size="30fp"
        ohos:right_of="$id:life_count_btn2"
        ohos:text_color="#6A5ACD"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:padding="20vp"
        ohos:text_weight="300"/>
    <Button
        ohos:id="$+id:life_count_btn4"
        ohos:text="钓鱼"
        ohos:below="$id:life_count_btn1"
        ohos:align_parent_left="true"
        ohos:text_size="30fp"
        ohos:text_color="#FFEC8B"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:padding="20vp"
        ohos:text_weight="300"/>
    <Button
        ohos:id="$+id:life_count_btn5"
        ohos:text="感冒"
        ohos:below="$id:life_tv"
        ohos:align_top="$id:life_count_btn4"
        ohos:text_size="30fp"
        ohos:text_color="#EEDC82"
        ohos:right_of="$id:life_count_btn4"
        ohos:height="match_content"
        ohos:padding="20vp"
        ohos:width="match_content"
        ohos:text_weight="300"/>
    <Button
        ohos:id="$+id:life_count_btn6"
        ohos:text="紫外线"
        ohos:below="$id:life_tv"
        ohos:align_top="$id:life_count_btn4"
        ohos:text_size="30fp"
        ohos:right_of="$id:life_count_btn5"
        ohos:text_color="#7CFC00"
        ohos:padding="20vp"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:text_weight="300"/>
    <Button
        ohos:id="$+id:life_count_btn7"
        ohos:text="洗车"
        ohos:below="$id:life_count_btn6"
        ohos:align_parent_left="true"
        ohos:text_size="30fp"
        ohos:text_color="#CD5C5C"
        ohos:padding="20vp"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:text_weight="300"/>
    <Button
        ohos:id="$+id:life_count_btn8"
        ohos:text="运动"
        ohos:below="$id:life_tv"
        ohos:align_top="$id:life_count_btn7"
        ohos:text_size="30fp"
        ohos:text_color="#F5DEB3"
        ohos:right_of="$id:life_count_btn7"
        ohos:height="match_content"
        ohos:padding="20vp"
        ohos:width="match_content"
        ohos:text_weight="300"/>
    <Button
        ohos:id="$+id:life_count_btn9"
        ohos:text="带伞"
        ohos:below="$id:life_tv"
        ohos:align_top="$id:life_count_btn8"
        ohos:text_size="30fp"
        ohos:right_of="$id:life_count_btn8"
        ohos:text_color="#CDAA7D"
        ohos:padding="20vp"
        ohos:height="match_content"
        ohos:width="match_content"
        ohos:text_weight="300"/>
</DependentLayout>