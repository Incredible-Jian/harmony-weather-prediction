<?xml version="1.0" encoding="utf-8"?>
<DirectionalLayout
    xmlns:ohos="http://schemas.huawei.com/res/ohos"
    ohos:height="match_parent"
    ohos:width="match_parent"
    ohos:orientation="vertical">
    <Button
        ohos:id="$+id:wkinds_btn"
        ohos:height="match_content"
        ohos:width="match_parent"
        ohos:text="返回主页"
        ohos:text_size="25vp"
        ohos:text_alignment="center"
        ohos:padding="5vp"
        ohos:background_element="#FF8DFF6D"
        ohos:text_color="#FFC152FD"
        />
    <Text
        ohos:id="$+id:wlist_tv1"
        ohos:height="match_content"
        ohos:width="match_parent"
        ohos:text="天气种类"
        ohos:text_size="25vp"
        ohos:background_element="#FF6DA9FF"
        ohos:text_color="#FFFDE252"
        ohos:padding="10vp"
        ohos:text_alignment="center"
        />
    <ListContainer
        ohos:id="$+id:weather_kinds_lc"
        ohos:height="match_parent"
        ohos:width="match_parent"/>
</DirectionalLayout>